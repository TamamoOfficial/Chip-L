<Window x:Class="ChipL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChipL"
        Title="Chip-L 桌面版 · CPU / GPU / SoC 规格库"
        Height="820" Width="1320" MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧：模块导航 -->
    <Border Grid.Column="0" Background="#FF141A22" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18,14,14">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,20">
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="9" Background="#FF25344A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
              <TextBlock Text="C" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Chip-L" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="桌面版" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,10" />
          <Button x:Name="UpdateButton" Style="{StaticResource FlatButton}" Click="OnUpdateDatabase"
                  HorizontalContentAlignment="Left" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⟳" FontSize="14" Margin="0,0,8,0" />
              <TextBlock Text="检查数据库更新" FontSize="12.5" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="DbStatusText" Text="数据库载入中…" FontSize="10.5"
                     Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="4,4,0,0" />
        </StackPanel>

        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="芯片类别" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="6,0,0,8" />
          <RadioButton DockPanel.Dock="Top" x:Name="NavCpu" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                       Checked="OnModuleChanged" Foreground="#FF4F9CFF">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▤" Margin="0,0,10,0" FontSize="14" />
              <StackPanel>
                <TextBlock Text="CPU 处理器" FontSize="13.5" />
                <TextBlock x:Name="CpuCountText" Text="—" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" />
              </StackPanel>
            </StackPanel>
          </RadioButton>
          <RadioButton DockPanel.Dock="Top" x:Name="NavGpu" Style="{StaticResource NavItem}" GroupName="nav"
                       Checked="OnModuleChanged" Foreground="#FF46D39A">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▦" Margin="0,0,10,0" FontSize="14" />
              <StackPanel>
                <TextBlock Text="GPU 显卡" FontSize="13.5" />
                <TextBlock x:Name="GpuCountText" Text="—" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" />
              </StackPanel>
            </StackPanel>
          </RadioButton>
          <RadioButton DockPanel.Dock="Top" x:Name="NavSoc" Style="{StaticResource NavItem}" GroupName="nav"
                       Checked="OnModuleChanged" Foreground="#FFF2A33C">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▩" Margin="0,0,10,0" FontSize="14" />
              <StackPanel>
                <TextBlock Text="SoC 芯片" FontSize="13.5" />
                <TextBlock x:Name="SocCountText" Text="—" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" />
              </StackPanel>
            </StackPanel>
          </RadioButton>

          <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,12,0,10" />

          <!-- 收藏列表：按 CPU / GPU / SoC 三个标签隔离 -->
          <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <TextBlock Text="收藏" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="FavCountText" DockPanel.Dock="Right" Text="0"
                       FontSize="10" Foreground="#FF7FA8D8" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </DockPanel>

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,6">
            <RadioButton x:Name="FavTabCpu" GroupName="favmod" Content="CPU" Style="{StaticResource TabRadio}"
                         Checked="OnFavTab" />
            <RadioButton x:Name="FavTabGpu" GroupName="favmod" Content="GPU" Style="{StaticResource TabRadio}"
                         Checked="OnFavTab" />
            <RadioButton x:Name="FavTabSoc" GroupName="favmod" Content="SoC" Style="{StaticResource TabRadio}"
                         Checked="OnFavTab" />
          </StackPanel>

          <Border Background="#FF141A22" CornerRadius="8" MinHeight="90" Margin="0,0,0,0">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,4">
                <StackPanel x:Name="FavPanel" />
              </ScrollViewer>
              <TextBlock x:Name="FavEmptyText" Text="还没有收藏"
                         FontSize="10.5" Foreground="#FF5E7089"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- 右侧：分栏 = 左（筛选+列表） | 右（详情） -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 白色区域：标题 + 对比入口 + 内联调试信息 -->
      <Border Grid.Row="0" Padding="20,14,20,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RandomButton" Style="{StaticResource FlatButton}" Click="OnPickRandom"
                    Margin="0,0,8,0" ToolTip="随机挑一款本类别的产品">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9860;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="随机" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="CompareButton" Style="{StaticResource FlatButton}" Click="OnOpenCompare" Margin="0,0,8,0">
              <TextBlock x:Name="CompareButtonText" Text="⇄  对比" />
            </Button>
            <Border x:Name="AgentBadge" Visibility="Collapsed" Background="#FF1B2331"
                    BorderBrush="#FF2A3546" BorderThickness="1" CornerRadius="6"
                    Padding="8,5" VerticalAlignment="Center"
                    ToolTip="本地 agent 调试接口，端点见 %LOCALAPPDATA% / ChipL / agent.json">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#FF46D39A" VerticalAlignment="Center" />
                <TextBlock x:Name="AgentBadgeText" Text="调试接口" FontSize="10.5"
                           Foreground="#FF95A3B8" Margin="6,0,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ModuleTitle" Text="CPU 处理器" FontSize="19" FontWeight="Bold" />
              <Border x:Name="AgentBanner" Visibility="Collapsed" Margin="12,0,0,0"
                      Background="#FF16241E" BorderBrush="#FF2E6B4F" BorderThickness="1"
                      CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="◉" FontSize="10" Foreground="#FF46D39A" VerticalAlignment="Center" />
                  <TextBlock x:Name="AgentBannerText" Text="" FontSize="10.5" Foreground="#FFCFE6DA"
                             Margin="6,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock x:Name="ModuleSlogan" Text="" FontSize="11"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 左右平行：左=筛选与列表  右=详情 -->
      <Grid Grid.Row="1" Margin="20,0,20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="360" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="3*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- 筛选 + 产品列表 -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="10,8" Margin="0,0,0,8">
            <local:NavigationBar x:Name="Nav" />
          </Border>

          <Border Grid.Row="1" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="132" />
              </Grid.ColumnDefinitions>
              <Grid>
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="26,7,7,7" />
                <TextBlock Text="&#8981;" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="搜索型号、代号、系列&#8230;" Margin="28,0,0,0"
                           Foreground="#FF5E7089" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
              <TextBlock Grid.Column="1" x:Name="ResultCount" Text="" Margin="10,0"
                         VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
              <ComboBox Grid.Column="2" x:Name="SortBox" SelectionChanged="OnSortChanged" Height="30"
                        Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" VerticalContentAlignment="Center" />
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="6,8" Margin="0">
            <Grid>
              <ListBox x:Name="ChipList" ItemContainerStyle="{StaticResource ChipListItem}"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       SelectionChanged="OnChipSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="8" Background="#FF223145"
                              BorderBrush="#FF2F4056" BorderThickness="1" VerticalAlignment="Center"
                              ClipToBounds="True">
                        <Grid>
                          <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="#FF7FA8D8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding Image}" Stretch="UniformToFill"
                                 RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <Border Background="#FF3A2E1B" BorderBrush="#FFF2A33C" BorderThickness="1"
                                  CornerRadius="4" Padding="4,0" Margin="5,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsUnconfirmed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="未确认" FontSize="9" Foreground="#FFF2A33C" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Button Style="{StaticResource RowIconButton}" Click="OnRowCompare"
                                Tag="{Binding}" ToolTip="加入对比">
                          <TextBlock Text="&#9878;" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource RowIconButton}" Click="OnRowFavorite"
                                Tag="{Binding}" ToolTip="收藏 / 取消收藏">
                          <TextBlock Text="{Binding FavoriteIcon}" FontSize="12"
                                     Foreground="{Binding FavoriteIconColor, Converter={StaticResource HexToBrush}}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EmptyHint" Text="没有匹配的芯片" Foreground="{StaticResource SubTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="10" Background="Transparent"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 详情 -->
        <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0" Padding="0">
          <Grid>
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="18,14">
              <StackPanel x:Name="DetailPanel" />
            </ScrollViewer>
            <TextBlock x:Name="DetailPlaceholder" Text="&#8592; 选择左侧任意芯片查看完整规格"
                       Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- 更新进度浮层 -->
    <Border x:Name="UpdateOverlay" Grid.ColumnSpan="2" Background="#CC080B10" Visibility="Collapsed">
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
              BorderThickness="1" CornerRadius="12" Padding="24,20" Width="420"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="正在更新数据库" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="UpdateStatusText" Text="准备中…" FontSize="11.5"
                     Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,14" TextWrapping="Wrap" />
          <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="100"
                       Background="#FF202936" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
