<Window x:Class="ChipL.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对比" Height="800" Width="1400" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" MinWidth="210" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="*" MinWidth="520" />
    </Grid.ColumnDefinitions>

    <!-- 左侧：只显示已加入对比的项目，可逐个移除 -->
    <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="12,10" Margin="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="BasketTitle" Text="已选对比项"
                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- 模块标签（切换查看不同模块的对比清单） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton x:Name="TabCpu" GroupName="cmpmod" Content="CPU" Style="{StaticResource TabRadio}"
                       Checked="OnModuleTab" />
          <RadioButton x:Name="TabGpu" GroupName="cmpmod" Content="GPU" Style="{StaticResource TabRadio}"
                       Checked="OnModuleTab" />
          <RadioButton x:Name="TabSoc" GroupName="cmpmod" Content="SoC" Style="{StaticResource TabRadio}"
                       Checked="OnModuleTab" />
        </StackPanel>

        <!-- 已选项列表：每行带移除按钮 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="BasketPanel" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="BasketEmpty" Text="尚未加入任何芯片"
                   FontSize="11" Foreground="{StaticResource SubTextBrush}"
                   VerticalAlignment="Top" Margin="2,6,0,0" Visibility="Collapsed" />

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="清空"
                  Padding="10,5" Click="OnClearBasket" />
          <TextBlock x:Name="CountText" Text="0 款" FontSize="11"
                     Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
        </DockPanel>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    <!-- 右侧：对比表 -->
    <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="0" Margin="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="14,12,14,8">
          <TextBlock x:Name="LegendText" DockPanel.Dock="Right" FontSize="10.5"
                     Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"
                     Text="橙色＝有差异 · 灰绿＝全部相同" />
          <TextBlock x:Name="HeaderText" Text="对比" FontSize="15" FontWeight="SemiBold" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,6">
          <StackPanel x:Name="DiffPanel" />
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint" Grid.Row="1"
                   Text="在主列表点每行右侧的 ⚖ 图标加入对比（至少 2 款）"
                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />

        <DockPanel Grid.Row="2" Margin="14,8,14,12">
          <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="关闭"
                  Width="84" Click="OnClose" />
          <TextBlock x:Name="TipText" FontSize="10.5" Foreground="{StaticResource SubTextBrush}"
                     VerticalAlignment="Center"
                     Text="同一时间只对比同类芯片（CPU / GPU / SoC 清单彼此独立）" />
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
